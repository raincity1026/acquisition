# 复制为 .env.prod 并改掉所有 CHANGE_ME。.env.prod 已在 .gitignore，别提交。

# --- 镜像仓库（腾讯云 TCR）---
# 走 CI 自动部署时这俩由 GitHub Actions 自动传入，无需在此设置。
# 只有【手动】在服务器 docker compose pull/up 时才需要解开下面两行：
# TCR_REGISTRY=ccr.ccs.tencentyun.com
# TCR_NAMESPACE=你的命名空间

# --- PostgreSQL（compose 用来建库 + 健康检查）---
POSTGRES_USER=acquisition
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=acquisition

# --- 后端 ---
# host=db（compose 服务名）、容器内端口 5432；密码与上面一致
DATABASE_URL=postgresql+asyncpg://acquisition:CHANGE_ME_use_a_strong_password@db:5432/acquisition
# 随机 32+ 字符。生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# --- 盘后定时更新 ---
SCHEDULER_ENABLED=true
UPDATE_HOUR=18
UPDATE_MINUTE=30
TZ=Asia/Shanghai
