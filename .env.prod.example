# 复制为 .env.prod 并改掉所有 CHANGE_ME。.env.prod 已在 .gitignore，别提交。
# 启动：docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- PostgreSQL（compose 用来建库 + 健康检查）---
POSTGRES_USER=marsian
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_DB=marsian

# --- 后端 ---
# host=db（compose 服务名）、容器内端口 5432；密码与上面一致
DATABASE_URL=postgresql+asyncpg://marsian:CHANGE_ME_use_a_strong_password@db:5432/marsian
# 随机 32+ 字符。生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# --- 盘后定时更新 ---
SCHEDULER_ENABLED=true
UPDATE_HOUR=18
UPDATE_MINUTE=30
TZ=Asia/Shanghai
